@page "/catalog"


<h1 class="text-red-500 text-5xl">
    Hola mundo
</h1>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var cafe in lstCafe)
    {
        <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:scale-110 transition">
            <img src="@cafe.Imagen" alt="@cafe.Nombre" class="w-full h-84 object-cover rounded-lg" />

            <div class="p-4">
                <h2 class="text-xl font-bold">@cafe.Nombre</h2>

                <p class="text-gray-600 mt-2">
                    @cafe.Descripcion
                </p>

                <p class="text-green-700 text-lg font-semibold mt-3">
                    Bs. @cafe.Precio.ToString("0.00")
                </p>
            </div>
        </div>
    }
</div>

@code {
    class Cafe
{
    public string Nombre { get; set; } = "";
    public string Descripcion { get; set; } = "";
    public double Precio { get; set; }
    public string Imagen { get; set; } = "";
}
    private List<Cafe> lstCafe = new List<Cafe>()
    {
        new Cafe
        {
