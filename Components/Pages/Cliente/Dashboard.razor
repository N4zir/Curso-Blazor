@page "/cliente"
@attribute [Authorize(Policy = "PortalCliente")]
@using System.Security.Claims
@inject ClienteService ClienteService
@inject CotizacionService CotizacionService
@inject ReservaService ReservaService
@inject EventoService EventoService
@inject AuthenticationStateProvider AuthState

<PageTitle>Mi portal | Cumbre Salones y Congresos</PageTitle>
<PortalClienteNav />
<h1 class="text-2xl font-bold">Dashboard</h1>
<p class="text-slate-600">Resumen de tus eventos y solicitudes.</p>

@if (cliente is null)
{
  <p class="mt-4 text-slate-600">Cargando perfil...</p>
}
else
{
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="ui-card p-4"><div class="text-sm text-slate-500">Cotizaciones</div><div class="text-2xl font-bold">@cotizaciones.Count</div></div>
    <div class="ui-card p-4"><div class="text-sm text-slate-500">Reservas</div><div class="text-2xl font-bold">@reservas.Count</div></div>
    <div class="ui-card p-4"><div class="text-sm text-slate-500">Eventos</div><div class="text-2xl font-bold">@eventos.Count</div></div>
    <div class="ui-card p-4"><div class="text-sm text-slate-500">Próximo evento</div><div class="text-sm font-semibold mt-1">@(proximo?.Titulo ?? "Sin próximos eventos")</div></div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="ui-card p-4">
      <h2 class="font-semibold">Cotizaciones recientes</h2>
      <ul class="mt-3 space-y-2 text-sm">
        @foreach (var c in cotizaciones.Take(5))
        { <li class="flex justify-between border-b border-slate-100 pb-2"><span>@c.Numero · @c.TipoEvento</span><span class="font-medium">@c.Estado</span></li> }
        @if(!cotizaciones.Any()){<li class="text-slate-500">Sin cotizaciones.</li>}
      </ul>
      <a href="/cliente/cotizaciones" class="ui-link mt-3 inline-block">Ver todas</a>
    </section>
    <section class="ui-card p-4">
      <h2 class="font-semibold">Reservas activas</h2>
      <ul class="mt-3 space-y-2 text-sm">
        @foreach (var r in reservas.Where(r=>r.Estado!=EstadoReserva.Cancelada).Take(5))
        { <li class="border-b border-slate-100 pb-2"><div class="font-medium">@r.Salon?.Nombre</div><div class="text-slate-600">@r.Inicio:g - @r.Fin:g · @r.Estado</div></li> }
        @if(!reservas.Any()){<li class="text-slate-500">Sin reservas.</li>}
      </ul>
      <a href="/cliente/reservas" class="ui-link mt-3 inline-block">Ver todas</a>
    </section>
  </div>
}

@code {
  private Cliente? cliente;
  private List<Cotizacion> cotizaciones = new();
  private List<Reserva> reservas = new();
  private List<Evento> eventos = new();
  private Evento? proximo;

  protected override async Task OnInitializedAsync()
  {
    var state = await AuthState.GetAuthenticationStateAsync();
    var uid = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (uid is null) return;
    cliente = await ClienteService.GetOrCreateByUserIdAsync(uid);
    if (cliente is null) return;
    cotizaciones = await CotizacionService.ListarPorClienteAsync(cliente.Id);
    reservas = await ReservaService.ListarPorClienteAsync(cliente.Id);
    eventos = await EventoService.ListarPorClienteAsync(cliente.Id);
    proximo = eventos.Where(e => e.FechaInicio >= DateTime.UtcNow).OrderBy(e => e.FechaInicio).FirstOrDefault();
  }
}
