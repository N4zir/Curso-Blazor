@page "/cliente/participantes"
@attribute [Authorize(Policy = "PortalCliente")]
@using System.Security.Claims
@inject ClienteService ClienteService
@inject EventoService EventoService
@inject AuthenticationStateProvider AuthState

<PageTitle>Participantes</PageTitle>
<PortalClienteNav />
<h1 class="text-2xl font-bold">Participantes</h1>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <section class="ui-card p-4 lg:col-span-2">
    <h2 class="font-semibold">Registrados</h2>
    <ul class="mt-3 space-y-2 text-sm">
      @foreach (var p in items)
      { <li class="border-b border-slate-100 pb-2"><div class="font-medium">@p.Nombre</div><div class="text-slate-600">@p.Email · @p.Evento?.Titulo · @p.Tipo</div></li> }
      @if(!items.Any()){<li class="text-slate-500">Sin participantes.</li>}
    </ul>
  </section>
  <section class="ui-card p-4">
    <h2 class="font-semibold">Agregar participante</h2>
    @if (eventos.Any())
    {
      <EditForm Model="form" OnValidSubmit="Agregar" FormName="add-part" class="mt-3 space-y-3">
        <div class="ui-field"><label class="ui-label">Evento</label>
          <InputSelect class="ui-input" @bind-Value="form.EventoId">@foreach(var e in eventos){<option value="@e.Id">@e.Titulo</option>}</InputSelect>
        </div>
        <div class="ui-field"><label class="ui-label">Nombre</label><InputText class="ui-input" @bind-Value="form.Nombre" /></div>
        <div class="ui-field"><label class="ui-label">Email</label><InputText class="ui-input" @bind-Value="form.Email" /></div>
        <div class="ui-field"><label class="ui-label">Tipo</label><InputText class="ui-input" @bind-Value="form.Tipo" /></div>
        <button class="ui-btn ui-btn-primary" type="submit">Agregar</button>
      </EditForm>
    }
    else { <p class="mt-2 text-sm text-slate-500">Necesitas un evento para registrar participantes.</p> }
  </section>
</div>

@code {
  private List<Participante> items = new();
  private List<Evento> eventos = new();
  private Cliente? cliente;
  [SupplyParameterFromForm] private PartForm form { get; set; } = new();

  protected override async Task OnInitializedAsync() => await Cargar();
  private async Task Cargar()
  {
    var state = await AuthState.GetAuthenticationStateAsync();
    var uid = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (uid is null) return;
    cliente = await ClienteService.GetOrCreateByUserIdAsync(uid);
    if (cliente is null) return;
    items = await EventoService.ParticipantesPorClienteAsync(cliente.Id);
    eventos = await EventoService.ListarPorClienteAsync(cliente.Id);
    if (form.EventoId == 0 && eventos.Any()) form.EventoId = eventos.First().Id;
  }
  private async Task Agregar()
  {
    if (cliente is null || form.EventoId == 0 || string.IsNullOrWhiteSpace(form.Nombre)) return;
    await EventoService.AgregarParticipanteAsync(new Participante { EventoId = form.EventoId, ClienteId = cliente.Id, Nombre = form.Nombre, Email = form.Email, Tipo = form.Tipo });
    form = new PartForm { EventoId = eventos.FirstOrDefault()?.Id ?? 0 };
    await Cargar();
  }
  private class PartForm { public int EventoId { get; set; } public string? Nombre { get; set; } public string? Email { get; set; } public string? Tipo { get; set; } }
}
